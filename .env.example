# Modo remoto (Supabase). Si falta alguna, la app funciona en modo demo con datos locales.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Slug de la clínica que muestra el sitio público de este despliegue
NEXT_PUBLIC_CLINIC_SLUG=clinica-sonrie
